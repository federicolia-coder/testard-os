#!/bin/sh
# Starts the graphical installer on the screen: a local web page
# (installer/) shown full screen by Firefox in the cage kiosk compositor.
# If the screen can't show it, the text installer is offered instead.

WWW=/run/testard/www
RUN=/run/testard

mkdir -p "$RUN"
# Serve a copy from /run: the installer removes /etc/testard/installer
# before it copies /etc to the disk.
if [ ! -d "$WWW" ]; then
	cp -a /etc/testard/installer "$WWW"
	chmod 0755 "$WWW"/cgi-bin/*
fi
if ! pgrep -f "httpd -p 127.0.0.1:8080" >/dev/null 2>&1; then
	busybox-extras httpd -p 127.0.0.1:8080 -h "$WWW" -c "$WWW/httpd.conf"
fi

export XDG_RUNTIME_DIR="$RUN/xdg"
mkdir -p "$XDG_RUNTIME_DIR"
chmod 0700 "$XDG_RUNTIME_DIR"

# First with the graphics card; if that can't start (no 3D acceleration,
# e.g. in VirtualBox or VMware), again drawing everything in software.
software=""
: > "$RUN/gui.log"
started=$(date +%s)
while :; do
	rm -f "$RUN/restart-screen"
	layout=$(cat "$RUN/xkb" 2>/dev/null || echo us)
	rm -rf "$RUN/firefox"
	mkdir -p "$RUN/firefox"
	attempt=$(date +%s)
	if [ -n "$software" ]; then
		set -- env WLR_RENDERER=pixman LIBGL_ALWAYS_SOFTWARE=1 MOZ_WEBRENDER=1 MOZ_ACCELERATED=0
	else
		set -- env
	fi
	"$@" XKB_DEFAULT_LAYOUT="$layout" MOZ_ENABLE_WAYLAND=1 seatd-launch -- cage -s -- \
		firefox-esr --kiosk --no-remote --profile "$RUN/firefox" "http://127.0.0.1:8080/" >> "$RUN/gui.log" 2>&1
	# The keyboard layout changed: start again with it.
	[ -f "$RUN/restart-screen" ] && continue
	# It stopped right away with the graphics card: try in software.
	if [ -z "$software" ] && [ $(( $(date +%s) - attempt )) -lt 15 ]; then
		software=1
		echo "== the graphics card didn't work; drawing in software" >> "$RUN/gui.log"
		started=$(date +%s)
		continue
	fi
	break
done

clear
if [ $(( $(date +%s) - started )) -lt 15 ]; then
	echo "The graphical installer couldn't start on this screen (to see why: cat $RUN/gui.log)."
else
	echo "The graphical installer closed."
fi
echo
echo "Use the text installer instead: type  testard-install  and press Enter."
echo
