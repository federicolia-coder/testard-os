#!/bin/sh
# Testard OS installer: installs the live system onto this machine's disk.
#
#   testard-install                  ask the questions in the terminal
#   testard-install --answers FILE   take the answers from FILE (the
#                                    graphical installer writes it)
#   testard-install --list-disks     print the disks it can install on
#   testard-install --find-installed print the disk Testard OS is already on
#   testard-install --restart        restart from the disk: eject the CD,
#                                    boot the disk next (UEFI), reboot
#
# It sets up the live system with Alpine's own tools (setup-alpine,
# setup-disk), copies it to the disk, and leaves the rest of the setup (SSH,
# firewall, updates, agent) to testard-setup on first boot.

set -eu
umask 022

[ "$(id -u)" -eq 0 ] || { echo "Run testard-install as root." >&2; exit 1; }

B=$(printf '\033[1m'); BLUE=$(printf '\033[1;34m'); DIM=$(printf '\033[2m'); R=$(printf '\033[0m')
FIRSTBOOT=/etc/testard/firstboot
STATE=/run/testard/state
LOG=/var/log/testard-install.log
ANSWERS=""

case "${1:-}" in
	--answers) ANSWERS="${2:?--answers needs a file}" ;;
	--list-disks|--find-installed|--restart|"") ;;
	*) echo "usage: testard-install [--answers FILE | --list-disks | --find-installed | --restart]" >&2; exit 2 ;;
esac

# Progress for the graphical installer: "running|percent|text", "done" or
# "failed|text". The terminal version just prints the text.
progress() { # progress PERCENT "text"
	mkdir -p /run/testard
	printf 'running|%s|%s\n' "$1" "$2" > "$STATE"
	[ -n "$ANSWERS" ] || printf '  %s\n' "$2"
}

die() {
	mkdir -p /run/testard
	printf 'failed|%s\n' "$*" > "$STATE"
	printf '\n%sThe installation stopped:%s %s\n' "$B" "$R" "$*" >&2
	exit 1
}
say() { printf '%s\n' "$*"; }

valid_host() { printf '%s' "$1" | grep -Eq '^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$'; }
valid_user() { printf '%s' "$1" | grep -Eq '^[a-z_][a-z0-9_-]{0,31}$' && [ "$1" != root ]; }
valid_agent_key() { printf '%s' "$1" | grep -Eq '^tsk_[A-Za-z0-9_-]{43}$'; }
valid_github() { printf '%s' "$1" | grep -Eq '^[A-Za-z0-9-]{1,39}$'; }
valid_pubkey() { printf '%s' "$1" | grep -Eq '^(ssh-(ed25519|rsa)|ecdsa-sha2-nistp(256|384|521)|sk-(ssh-ed25519|ecdsa-sha2-nistp256)@openssh\.com) [A-Za-z0-9+/=]+( [^ ]*)*$'; }
valid_ports() { [ -z "$1" ] || printf '%s' "$1" | grep -Eq '^[0-9]{1,5}(-[0-9]{1,5})?(/(tcp|udp))?(,[0-9]{1,5}(-[0-9]{1,5})?(/(tcp|udp))?)*$'; }
valid_keymap() { [ "$1" = us ] || { printf '%s' "$1" | grep -Eq '^[a-z]{2,3}$' && [ -d "/usr/share/bkeymaps/$1" ]; }; } # us is the built-in default

# ── Disks ────────────────────────────────────────────────────────────────

# The USB stick we booted from holds the package repository; never offer it.
boot_disk() {
	awk '$2 ~ /^\/media\// {print $1, $2}' /proc/mounts | while read -r dev mnt; do
		[ -d "$mnt/apks" ] && basename "$dev" | sed -E 's/p?[0-9]+$//'
	done | head -n 1
}

list_disks() { # one line per disk: name size-in-GB model
	skip=$(boot_disk)
	for d in /sys/block/*; do
		n=$(basename "$d")
		case "$n" in loop*|ram*|sr*|zram*|dm-*|md*|fd*) continue ;; esac
		[ "$n" = "$skip" ] && continue
		size=$(cat "$d/size")
		[ "$size" -gt 0 ] || continue
		gb=$(awk -v s="$size" 'BEGIN {printf "%.0f", s * 512 / 1000000000}')
		model=$(tr -s ' ' 2>/dev/null < "$d/device/model" | sed 's/ *$//' || true)
		printf '%s %s %s\n' "$n" "$gb" "$model"
	done
}

# A disk that already has Testard OS on it: its root partition holds
# /etc/testard/setup.conf. Mounted read-only, just to look.
find_installed() {
	mnt=$(mktemp -d)
	for n in $(list_disks | awk '{print $1}'); do
		for p in /sys/block/"$n"/"$n"*; do
			[ -e "$p/partition" ] || continue
			part=$(basename "$p")
			if mount -o ro "/dev/$part" "$mnt" 2>/dev/null; then
				found=""
				[ -f "$mnt/etc/testard/setup.conf" ] && found=1
				umount "$mnt"
				if [ -n "$found" ]; then rmdir "$mnt"; echo "$n"; return 0; fi
			fi
		done
	done
	rmdir "$mnt"
	return 1
}

# UEFI: an entry for the installed disk, first in the boot order, so the
# machine starts from the disk even if the USB stick or ISO is still in.
# (setup-disk installs GRUB with --no-nvram, so there's no entry otherwise.)
add_uefi_entry() { # add_uefi_entry DISK
	[ -d /sys/firmware/efi ] || return 0
	mountpoint -q /sys/firmware/efi/efivars 2>/dev/null || mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null || true
	command -v efibootmgr >/dev/null 2>&1 || apk add --quiet efibootmgr >/dev/null 2>&1 || return 0
	for p in /sys/block/"$1"/"$1"*; do
		[ -e "$p/partition" ] || continue
		part=$(basename "$p")
		blkid "/dev/$part" 2>/dev/null | grep -q 'TYPE="vfat"' || continue
		# Replace an older entry of ours rather than piling them up.
		efibootmgr 2>/dev/null | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\} Testard OS.*/\1/p' | while read -r num; do
			efibootmgr -q -b "$num" -B >/dev/null 2>&1 || true
		done
		efibootmgr -q -c -d "/dev/$1" -p "$(cat "$p/partition")" -L "Testard OS" -l '\EFI\alpine\grubx64.efi' >/dev/null 2>&1 || true
		return 0
	done
}

restart_from_disk() {
	disk=$(find_installed || true)
	[ -z "$disk" ] || add_uefi_entry "$disk"
	for d in /dev/sr*; do [ -e "$d" ] && eject "$d" >/dev/null 2>&1; done
	sync
	reboot
}

case "${1:-}" in
	--list-disks) list_disks; exit 0 ;;
	--find-installed) find_installed; exit $? ;;
	--restart) restart_from_disk; exit 0 ;;
esac

# ── Answers ──────────────────────────────────────────────────────────────

ask() { # ask VAR "Question" "default"
	printf '%s%s%s%s: ' "$B" "$2" "$R" "${3:+ [$3]}"
	IFS= read -r _ans || _ans=""
	[ -n "$_ans" ] || _ans="$3"
	eval "$1=\$_ans"
}

ask_answers_in_terminal() {
	printf '\n%stestard%s.%s OS installer\n' "$B" "$BLUE" "$R"
	say "${DIM}Press Enter to accept the value in brackets. Ctrl+C stops without changing anything.${R}"
	echo

	while :; do
		ask KB "Keyboard layout (us, it, de, fr, es, gb…)" "us"
		[ "$KB" != uk ] || KB=gb
		valid_keymap "$KB" && break
		say "Unknown layout."
	done
	setup-keymap "$KB" "$KB" >/dev/null 2>&1 || true

	while :; do
		ask MODE "How will you use it: homelab (at home, on your network) or server (VPS, datacenter)" "homelab"
		case "$MODE" in homelab|server) break ;; esac
	done

	while :; do
		ask HOST "Server name" "$( [ "$MODE" = homelab ] && echo homelab || echo server)"
		valid_host "$HOST" && break
		say "Use lower case letters, digits and dashes, e.g. homelab-1."
	done

	while :; do
		ask TZ_NAME "Time zone" "Europe/Rome"
		[ -f "/usr/share/zoneinfo/$TZ_NAME" ] && break
		say "Unknown time zone. Examples: Europe/Rome, Europe/London, America/New_York, UTC."
	done

	while :; do
		ask ADMIN "Your user name (you'll log in with it; root login is turned off)" ""
		valid_user "$ADMIN" && break
		say "Use lower case letters, digits, - or _, e.g. mario."
	done

	while :; do
		stty -echo 2>/dev/null || true
		printf '%sPassword for %s%s: ' "$B" "$ADMIN" "$R"; IFS= read -r PW || PW=""; echo
		printf '%sSame password again%s: ' "$B" "$R"; IFS= read -r PW2 || PW2=""; echo
		stty echo 2>/dev/null || true
		if [ "${#PW}" -lt 8 ]; then say "At least 8 characters, please."
		elif [ "$PW" != "$PW2" ]; then say "The two passwords don't match."
		else break; fi
	done
	PW2=""

	say ""
	say "${DIM}SSH keys let you log in from another computer without a password.${R}"
	ask GITHUB "GitHub username to take your SSH keys from (empty to skip)" ""
	SSH_KEY=""
	[ -n "$GITHUB" ] || ask SSH_KEY "Or paste a public SSH key, e.g. ssh-ed25519 AAAA… (empty to skip)" ""

	while :; do
		ask CONTAINERS "Container engine: docker or none" "$( [ "$MODE" = homelab ] && echo docker || echo none)"
		case "$CONTAINERS" in docker|none) break ;; esac
	done

	while :; do
		ask OPEN_PORTS "Ports to open besides SSH, e.g. 80,443 (none for none)" "none"
		[ "$OPEN_PORTS" != none ] || OPEN_PORTS=""
		valid_ports "$OPEN_PORTS" && break
		say "Use ports like 80,443,51820/udp."
	done

	say ""
	say "${DIM}To see this server in Testard: Cloud Providers → Connect provider → Any server, then copy the key.${R}"
	stty -echo 2>/dev/null || true
	printf '%sTestard agent key, tsk_… (empty to skip)%s: ' "$B" "$R"; IFS= read -r AGENT_KEY || AGENT_KEY=""; echo
	stty echo 2>/dev/null || true
	if [ -n "$AGENT_KEY" ] && ! valid_agent_key "$AGENT_KEY"; then
		say "That isn't an agent key, skipping it. You can add one later: sudo testard-setup --agent-key tsk_…"
		AGENT_KEY=""
	fi

	disks=$(list_disks)
	[ -n "$disks" ] || die "no disk found to install on (the USB stick itself can't be used)."
	echo
	say "${B}Disks${R}"
	printf '%s\n' "$disks" | while read -r n gb model; do say "  $n   $gb GB   $model"; done
	first=$(printf '%s\n' "$disks" | awk 'NR==1 {print $1}')
	while :; do
		ask DISK "Disk to install on" "$first"
		DISK=${DISK#/dev/}
		printf '%s\n' "$disks" | awk '{print $1}' | grep -qx "$DISK" && break
		say "Pick one of: $(printf '%s\n' "$disks" | awk '{print $1}' | tr '\n' ' ')"
	done

	echo
	say "${B}Everything on $DISK will be erased.${R} Testard OS will be installed there, named $HOST, for $ADMIN."
	ask CONFIRM "Type the disk name ($DISK) to go ahead" ""
	[ "$CONFIRM" = "$DISK" ] || { say "Nothing changed."; exit 0; }
	echo
	say "${B}Installing…${R} ${DIM}(this takes a few minutes)${R}"
}

read_answers() { # KEY=value lines; read as data, never executed
	get() { sed -n "s/^$1=//p" "$ANSWERS" | head -n 1; }
	KB=$(get KB); MODE=$(get MODE); HOST=$(get HOST); TZ_NAME=$(get TZ)
	ADMIN=$(get ADMIN); PW=$(get PASSWORD); GITHUB=$(get GITHUB); SSH_KEY=$(get SSH_KEY)
	CONTAINERS=$(get CONTAINERS); OPEN_PORTS=$(get OPEN_PORTS); AGENT_KEY=$(get AGENT_KEY); DISK=$(get DISK)
	rm -f "$ANSWERS" # it holds the password

	valid_keymap "$KB" || die "unknown keyboard layout"
	case "$MODE" in homelab|server) ;; *) die "pick homelab or server" ;; esac
	valid_host "$HOST" || die "the server name may use lower case letters, digits and dashes"
	[ -f "/usr/share/zoneinfo/$TZ_NAME" ] || die "unknown time zone"
	valid_user "$ADMIN" || die "the user name may use lower case letters, digits, - and _"
	[ "${#PW}" -ge 8 ] || die "the password needs at least 8 characters"
	[ -z "$GITHUB" ] || valid_github "$GITHUB" || die "that isn't a GitHub username"
	[ -z "$SSH_KEY" ] || valid_pubkey "$SSH_KEY" || die "that isn't a public SSH key"
	case "$CONTAINERS" in docker|none) ;; *) die "pick docker or none" ;; esac
	valid_ports "$OPEN_PORTS" || die "ports look like 80,443,51820/udp"
	[ -z "$AGENT_KEY" ] || valid_agent_key "$AGENT_KEY" || die "that isn't a Testard agent key"
	list_disks | awk '{print $1}' | grep -qx "$DISK" || die "that disk can't be used"
	setup-keymap "$KB" "$KB" >/dev/null 2>&1 || true
}

if [ -n "$ANSWERS" ]; then read_answers; else ask_answers_in_terminal; fi

# If anything below stops the script unexpectedly, say so instead of
# leaving the graphical installer waiting.
finished=0
trap '[ "$finished" = 1 ] || { mkdir -p /run/testard; grep -q "^failed" "$STATE" 2>/dev/null || printf "failed|Something went wrong (see %s)\n" "$LOG" > "$STATE"; }' EXIT

# ── Configure the live system, then copy it to the disk ──────────────────

: > "$LOG"
progress 5 "Setting up the system"

release=$(cut -d. -f1,2 /etc/alpine-release)
mirror="https://dl-cdn.alpinelinux.org/alpine/v$release"
# The package repository on the USB stick; setup-alpine drops it, so keep it.
media_repo=$(grep '^/media/' /etc/apk/repositories | head -n 1 || true)
# Keep the device manager the live system runs (udev for the graphical
# installer), so the screen, keyboard and mouse keep working.
if [ -d /run/udev ]; then devd=udev; else devd=mdev; fi

setup_answers=$(mktemp)
cat > "$setup_answers" <<EOF
KEYMAPOPTS="$KB $KB"
HOSTNAMEOPTS="$HOST"
DEVDOPTS=$devd
INTERFACESOPTS="auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp
"
DNSOPTS=none
TIMEZONEOPTS="$TZ_NAME"
PROXYOPTS=none
APKREPOSOPTS="$mirror/main"
USEROPTS=none
SSHDOPTS=openssh
NTPOPTS=chrony
DISKOPTS=none
LBUOPTS=none
APKCACHEOPTS=none
EOF

# -e: no root password for now; root is locked below.
setup-alpine -e -f "$setup_answers" >> "$LOG" 2>&1 || die "setup-alpine failed (see $LOG)"
rm -f "$setup_answers"

# Packages from the USB stick first (works offline), then Alpine's mirror.
{
	[ -z "$media_repo" ] || echo "$media_repo"
	echo "$mirror/main"
	echo "$mirror/community"
} > /etc/apk/repositories

progress 25 "Creating your account"
# Account and password are in /etc, so they're copied to the disk.
id "$ADMIN" >/dev/null 2>&1 || adduser -D -s /bin/sh "$ADMIN"
addgroup "$ADMIN" wheel >/dev/null 2>&1 || true
printf '%s:%s\n' "$ADMIN" "$PW" | chpasswd >> "$LOG" 2>&1
PW=""
passwd -l root >/dev/null 2>&1 || true

# Packages for the installed system. They're installed straight onto the
# disk by setup-disk (from the USB stick), not into this live system's RAM.
pkgs="nftables sudo curl ca-certificates tzdata openssh-server"
[ "$CONTAINERS" = none ] || pkgs="$pkgs docker docker-cli-compose"
[ "$MODE" = server ] || pkgs="$pkgs avahi dbus"
# Only the live system needs these (the graphical installer).
live_only="firefox-esr cage seatd seatd-launch mesa-dri-gallium xkeyboard-config font-dejavu busybox-extras"

# sudo for the admin user right away, not only after first boot.
mkdir -p /etc/sudoers.d
printf '%%wheel ALL=(ALL:ALL) ALL\n' > /etc/sudoers.d/10-testard-wheel
chmod 0440 /etc/sudoers.d/10-testard-wheel

progress 45 "Saving your choices for the first boot"
mkdir -p "$FIRSTBOOT"
chmod 0700 "$FIRSTBOOT"
cat > /etc/testard/setup.conf <<EOF
# Choices from the last run of testard-setup, used as defaults next time.
ADMIN=$ADMIN
PROFILE=$MODE
CONTAINERS=$CONTAINERS
OPEN_PORTS=$OPEN_PORTS
FIREWALL=1
HARDEN_SSH=1
AUTO_UPDATES=1
EOF
: > "$FIRSTBOOT/authorized_keys"
if [ -n "$SSH_KEY" ]; then printf '%s\n' "$SSH_KEY" > "$FIRSTBOOT/authorized_keys"; fi
if [ -n "$GITHUB" ]; then
	if curl -fsSL -m 20 "https://github.com/$GITHUB.keys" > "$FIRSTBOOT/authorized_keys.tmp" 2>/dev/null && [ -s "$FIRSTBOOT/authorized_keys.tmp" ]; then
		sed "s/\$/ github:$GITHUB/" "$FIRSTBOOT/authorized_keys.tmp" >> "$FIRSTBOOT/authorized_keys"
	else
		# No network now: try again on first boot.
		printf '%s\n' "$GITHUB" > "$FIRSTBOOT/github-user"
	fi
	rm -f "$FIRSTBOOT/authorized_keys.tmp"
fi
if [ -n "$AGENT_KEY" ]; then (umask 077; printf '%s\n' "$AGENT_KEY" > "$FIRSTBOOT/agent-key"); fi
AGENT_KEY=""

mkdir -p /etc/local.d
cat > /etc/local.d/testard-firstboot.start <<'EOF'
#!/bin/sh
# Testard OS first boot: finish the setup with the choices made in the
# installer, then remove this file. If there's no network yet, it tries
# again at the next boot.
FB=/etc/testard/firstboot
LOG=/var/log/testard-firstboot.log
ADMIN=$(sed -n 's/^ADMIN=//p' /etc/testard/setup.conf)
{
	echo "== $(date)"
	# The USB stick's repository was only needed to install.
	sed -i '/^\/media\//d; /^#\/media\//d' /etc/apk/repositories
	# Boot menu: Testard OS, straight through.
	if [ -f /etc/update-extlinux.conf ]; then
		for kv in hidden=1 timeout=1; do
			k=${kv%%=*}
			if grep -q "^$k=" /etc/update-extlinux.conf; then sed -i "s/^$k=.*/$kv/" /etc/update-extlinux.conf; else echo "$kv" >> /etc/update-extlinux.conf; fi
		done
		update-extlinux >/dev/null 2>&1 || true
	fi
	if [ -f /etc/default/grub ]; then
		for kv in 'GRUB_DISTRIBUTOR="Testard OS"' GRUB_TIMEOUT=1; do
			k=${kv%%=*}
			if grep -q "^$k=" /etc/default/grub; then sed -i "s/^$k=.*/$kv/" /etc/default/grub; else echo "$kv" >> /etc/default/grub; fi
		done
		grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || true
	fi
	mkdir -p /usr/local/sbin
	install -m 0755 /etc/testard/testard-setup /usr/local/sbin/testard-setup
	home=$(awk -F: -v u="$ADMIN" '$1==u {print $6}' /etc/passwd)
	if [ -n "$home" ] && [ ! -d "$home" ]; then
		mkdir -p "$home" && chown "$ADMIN:$(id -gn "$ADMIN")" "$home" && chmod 0750 "$home"
	fi
	set --
	if [ -f "$FB/github-user" ]; then set -- "$@" --github "$(cat "$FB/github-user")"; fi
	while IFS= read -r k; do [ -n "$k" ] && set -- "$@" --ssh-key "$k"; done < "$FB/authorized_keys"
	if [ -f "$FB/agent-key" ]; then TESTARD_AGENT_KEY="$(cat "$FB/agent-key")"; export TESTARD_AGENT_KEY; fi
	if /usr/local/sbin/testard-setup --yes --user "$ADMIN" "$@"; then
		rm -rf "$FB" /etc/local.d/testard-firstboot.start
		: > /etc/motd
		echo "== first boot setup finished"
	else
		echo "== first boot setup failed; it will run again at the next boot"
	fi
} >> "$LOG" 2>&1
EOF
chmod 0755 /etc/local.d/testard-firstboot.start
rc-update add local default >/dev/null 2>&1

# The installed system's /etc: this live system's, minus what only the live
# system needs, plus the server's packages. setup-disk installs from it.
progress 50 "Preparing the installed system"
stage=$(mktemp -d)
lbu package - 2>>"$LOG" | tar -C "$stage" -zx || die "couldn't package the configuration (see $LOG)"
{
	awk -v drop="$live_only" 'BEGIN { n = split(drop, d, " "); for (i = 1; i <= n; i++) skip[d[i]] = 1 } NF && !($1 in skip)' /etc/apk/world
	for p in $pkgs; do echo "$p"; done
} | sort -u > "$stage/etc/apk/world"
cat > "$stage/etc/motd" <<EOF

  Testard OS is finishing its setup (log: /var/log/testard-firstboot.log).

EOF
rm -rf "$stage/etc/profile.d/testard-live.sh" "$stage/etc/testard/live-login" "$stage/etc/testard/installer" \
	"$stage/etc/testard/testard-gui" "$stage/etc/firefox"
sed -i 's#^tty1::respawn:.*#tty1::respawn:/sbin/getty 38400 tty1#' "$stage/etc/inittab"
if [ "$CONTAINERS" = docker ]; then # mounted at boot, before Docker starts
	mkdir -p "$stage/etc/runlevels/boot"
	ln -sf /etc/init.d/cgroups "$stage/etc/runlevels/boot/cgroups"
fi
printf '\033[H\033[2J\nTestard OS (Alpine Linux) \\r on \\m (\\l)\n\n' > "$stage/etc/issue"
ovl="$stage.apkovl.tar.gz"
# Top-level names only (etc, …), the way lbu writes them.
# shellcheck disable=SC2046
tar -C "$stage" -czf "$ovl" $(ls -A "$stage") || die "couldn't package the configuration"
rm -rf "$stage"

progress 55 "Copying Testard OS to $DISK"
ERASE_DISKS="/dev/$DISK" setup-disk -o "$ovl" -m sys "/dev/$DISK" >> "$LOG" 2>&1 \
	|| die "couldn't install to $DISK (see $LOG)"
rm -f "$ovl"
progress 95 "Making the disk start first"
add_uefi_entry "$DISK" >> "$LOG" 2>&1

mkdir -p /run/testard
finished=1
echo 'done' > "$STATE"
if [ -z "$ANSWERS" ]; then
	echo
	say "${B}Done.${R} Testard OS is installed on $DISK."
	say "Remove the USB stick, then restart with: testard-install --restart"
	say "After the restart, log in as $ADMIN. The first boot finishes the setup in about a minute."
else
	say "Testard OS is installed on $DISK."
fi
